# GPU-enabled MMSeqs2 Docker image
# Requires NVIDIA GPU with driver >= 525.60.13
FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

SHELL ["/bin/bash", "-c"]

# Install dependencies
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential \
      cmake \
      wget \
      git \
      curl \
      tar \
      awscli \
      python3 \
      python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get autoremove -y \
    && apt-get clean

# Install MMSeqs2 GPU binary (x86_64)
RUN wget -q https://mmseqs.com/latest/mmseqs-linux-gpu.tar.gz -O mmseqs.tar.gz \
  && tar xzf mmseqs.tar.gz \
  && mv mmseqs/bin/mmseqs /usr/local/bin/mmseqs \
  && chmod +x /usr/local/bin/mmseqs \
  && rm -rf mmseqs mmseqs.tar.gz

# Copy scripts
COPY . /opt/mmseqs

WORKDIR /opt/mmseqs

RUN chmod 755 /opt/mmseqs/run.sh \
  && chmod 755 /opt/mmseqs/run_mmseqs_msa.sh

ENTRYPOINT ["bash", "/opt/mmseqs/run.sh"]
